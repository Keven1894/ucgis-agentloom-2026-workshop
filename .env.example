# Copy to .env and fill in. .env is gitignored.

# Required for D2 OpenAQ source. Register free key at:
#   https://explore.openaq.org/account
# Free tier limits: 60 req/min, 10k req/day. Header is X-API-Key.
OPENAQ_API_KEY=

# Required only for the agent itself (Cline / scripts that call LLMs).
# NOT needed for Phase 0–1 data work.
OPENAI_API_KEY=
